{
  "expo": {
    "name": "NotasApp",
    "slug": "notas-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "notasapp",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.notasapp",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Este aplicativo usa autenticação biométrica para proteger suas configurações de segurança."
      }
    },
    "android": {
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.notasapp",
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          },
          "android": {
            "enableHermes": true,
            "extraMavenRepos": [
              "../../node_modules/expo-camera/android/maven"
            ]
          }
        }
      ],
      "expo-local-authentication",
      [
        "expo-notifications",
        {
          "color": "#2C322E"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "jsEngine": "hermes",
    "extra": {
      "apiBaseUrl": "http://192.168.1.8:5000"
    }
  }
}
